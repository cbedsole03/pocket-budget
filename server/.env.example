# Copy to .env on the server. Never commit real values.

APP_API_TOKEN=change-me-to-a-long-random-token
PUBLIC_BASE_URL=https://budget.example.com
DATABASE_PATH=data/pocket_budget.sqlite3
DATA_ENCRYPTION_KEY=generate-with-server-scripts-generate-key-py

# Plaid Sandbox first. Use development/production only after the app is working.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_PRODUCTS=transactions,investments
PLAID_COUNTRY_CODES=US

# Register this exact HTTPS URL in the Plaid dashboard for OAuth institutions.
PLAID_REDIRECT_URI=https://budget.example.com/link/oauth-return

